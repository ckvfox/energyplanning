# Apache baseline config for static SPA hosting

# ---------------------------------------------------------------------------
# Bot / crawler detection
# Recognised crawlers and accessibility tools receive a pre-rendered, script-
# free HTML snapshot (index-static.html) instead of the interactive SPA so
# that search engines and screen-reader evaluation tools can index the full
# page content without executing JavaScript or passing a JS challenge.
# ---------------------------------------------------------------------------
BrowserMatchNoCase "Googlebot"           IS_BOT
BrowserMatchNoCase "Googlebot-Image"     IS_BOT
BrowserMatchNoCase "Googlebot-News"      IS_BOT
BrowserMatchNoCase "Googlebot-Video"     IS_BOT
BrowserMatchNoCase "AdsBot-Google"       IS_BOT
BrowserMatchNoCase "bingbot"             IS_BOT
BrowserMatchNoCase "adidxbot"            IS_BOT
BrowserMatchNoCase "MicrosoftPreview"    IS_BOT
BrowserMatchNoCase "Slurp"               IS_BOT
BrowserMatchNoCase "DuckDuckBot"         IS_BOT
BrowserMatchNoCase "Baiduspider"         IS_BOT
BrowserMatchNoCase "YandexBot"           IS_BOT
BrowserMatchNoCase "facebot"             IS_BOT
BrowserMatchNoCase "ia_archiver"         IS_BOT
BrowserMatchNoCase "AhrefsBot"           IS_BOT
BrowserMatchNoCase "SemrushBot"          IS_BOT
BrowserMatchNoCase "MJ12bot"             IS_BOT
BrowserMatchNoCase "Screaming Frog"      IS_BOT
BrowserMatchNoCase "WAVE Accessibility"  IS_BOT
BrowserMatchNoCase "axe-core"            IS_BOT
BrowserMatchNoCase "Lighthouse"          IS_BOT
BrowserMatchNoCase "Chrome-Lighthouse"   IS_BOT

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Enforce HTTPS before other rewrites
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Block access to hidden files/folders except .well-known
  RewriteRule (^|/)\.(?!well-known/) - [F]

  # Serve pre-rendered snapshot to recognised bots (root and /index.html)
  RewriteCond %{ENV:IS_BOT} =1
  RewriteCond %{REQUEST_FILENAME} !index-static\.html$
  RewriteRule ^(index\.html)?$ /index-static.html [L]

  # Keep direct access for existing files/folders, fallback unknown routes to index.html
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Vary: User-Agent ensures proxies/CDNs cache bot and user responses separately
  <FilesMatch "\.html$">
    Header append Vary "User-Agent"
  </FilesMatch>

  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests; block-all-mixed-content"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "no-referrer"
  Header always set Permissions-Policy "accelerometer=(), ambient-light-sensor=(), autoplay=(), battery=(), camera=(), cross-origin-isolated=(), display-capture=(), document-domain=(), encrypted-media=(), execution-while-not-rendered=(), execution-while-out-of-viewport=(), fullscreen=(), geolocation=(), gyroscope=(), hid=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), speaker-selection=(), usb=(), web-share=(), xr-spatial-tracking=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"

  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"

  <FilesMatch "\.(?:css|js|mjs|png|jpe?g|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000, immutable"
  </FilesMatch>

  <FilesMatch "\.(?:html|json)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType application/json "access plus 1 hour"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType application/x-javascript "access plus 1 month"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css text/javascript application/javascript application/json
</IfModule>