# Umgebungsvariablen für Daten-Update-Skripte
# Diese Datei enthält KEINE echten Werte – kopiere sie nach .env und trage deine Schlüssel ein.
# .env wird niemals ins Repository committed (siehe .gitignore).

# OpenAI API Key – benötigt für scripts/fetch_subsidies.py und scripts/fetch_subsidy_prices.py
# Erstelle einen Schlüssel unter: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Automatic deployment: configure these as GitHub Actions repository secrets.
# Do not put real values in this example. FTP target is fixed in deploy_site.py.
FTP_SERVER=ftp.example.invalid
FTP_USERNAME=example-user
FTP_PASSWORD=replace-in-github-secrets
